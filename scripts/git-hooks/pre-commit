#!/bin/sh
# README.md — полная сборка архива: пересобирается перед каждым коммитом.
cd "$(git rev-parse --show-toplevel)" || exit 1
if python3 scripts/merge.py --mode both >/dev/null; then
    git add README.md
    echo "[pre-commit] README.md пересобран и добавлен в коммит"
else
    echo "pre-commit: сборка не удалась — README.md не обновлён" >&2
fi
